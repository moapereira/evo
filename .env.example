# Copie para .env e preencha. NUNCA commite o .env.

PORT=3000
# Só a própria máquina acessa por padrão. Use 0.0.0.0 para liberar na rede do escritório.
# HOST=127.0.0.1

# Fontes de dados: mock (dados de exemplo) | real
SOURCE_VENDAS=mock
SOURCE_SUPORTE=mock
SOURCE_FUNIL=mock
SOURCE_NEGOCIO=mock

# Limites em horas
LIMITE_SUPORTE_HORAS=24
LIMITE_FUNIL_HORAS=48

# Dias sem movimento de mensagens oficiais para alertar o cliente
LIMITE_INSTANCIAS_DIAS=3

# Nomes que são a mesma pessoa, para o ranking ("apelido=nome completo", separados por vírgula)
VENDEDORES_ALIAS=Nicole=Nicole Assis

# Vendas que o Nexu não diz de quem são ("cliente=vendedor", separados por ponto e vírgula)
VENDEDOR_POR_CLIENTE=Total Andradina - Droga Barão=Nicole Assis; neidrogas.atenderbem.com=Nicole Assis; OLIVEIRA & LISSONI LTDA=Lorena Fagundes

# Vendas que NÃO são de hoje apesar de aparecerem editadas hoje (nome do cliente ou id do lead, separados por ponto e vírgula).
# Use na primeira execução do Evo: ele não sabe quando um lead já ganho foi realmente ganho.
VENDAS_IGNORAR=Total Andradina - Droga Barão

# Reuniões do comercial (lidas da agenda do Microsoft 365). Meta de reuniões REALIZADAS por dia:
META_REUNIOES_DIA=10
SOURCE_REUNIOES=real
# Quem conta (nomes como estão no Nexu; o e-mail vem de lá). Só reuniões do Teams, sem canceladas/recusadas/dia inteiro:
REUNIOES_PESSOAS=Ityara Oliveira,Nicole Assis,Camilla Caldeira,Daniel Miguel,Hugo Henrique Belini
# Microsoft 365 (Entra ID > Registros de aplicativo > permissão de APLICATIVO Calendars.Read, com consentimento do admin)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Intervalo de atualização (segundos)
POLL_SEGUNDOS=120

# Teams: URL do webhook (Workflows > "Postar em um canal quando receber uma solicitação de webhook")
TEAMS_WEBHOOK_URL=

# Nexu (funil de implantação e vendas)
NEXU_BASE_URL=https://unicocontato.nexusistemas.com
# Etapas do funil de vendas que contam como venda fechada (separadas por vírgula)
NEXU_ETAPAS_GANHO=Ganho
# Etapas do kanban de implantação ignoradas no funil (sem acento ou maiúscula; separe por vírgula)
# Kanbans lidos (primeiro = principal; os demais ganham prefixo no painel)
NEXU_FUNIS=Implantação,Upsell / Expansão
NEXU_FUNIL_IGNORAR=Berçario,Configuração Serviços Extra
NEXU_TOKEN=

# Atender Bem (suporte)
# Ids das filas que contam como suporte (separados por vírgula)
ATENDERBEM_FILAS=254
ATENDERBEM_BASE_URL=https://unicocontato.atenderbem.com
ATENDERBEM_TOKEN=

# Chat inteligente (opcional; sem a chave o chat responde com regras simples)
ANTHROPIC_API_KEY=
